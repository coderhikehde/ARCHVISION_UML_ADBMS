// ArchVision AI — production schema (PostgreSQL 15+)
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma/client"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  idempotencyRecords IdempotencyRecord[]
  memberships   WorkspaceMember[]
  auditLogs     AuditLog[]
  comments      Comment[]
  adrs          Adr[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum OrgRole {
  admin
  editor
  viewer
  guest
}

/// Multi-tenant workspace (Epic 3). Projects stay user-owned for now;
/// organizations gate collaboration and will own shared projects when the
/// real-time layer lands.
model Organization {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  auditLogs AuditLog[]

  @@index([createdAt])
}

/// Role-based membership. (organizationId, userId) uniqueness makes joins
/// race-safe; role changes are enforced at the service layer.
model WorkspaceMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(viewer)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id           String    @id @default(cuid())
  name         String
  description  String?
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  githubRepo   String?
  githubBranch String    @default("main")
  lastSyncedAt DateTime?
  syncing      Boolean   @default(false)
  diagrams     Diagram[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Diagram {
  id               String              @id @default(cuid())
  name             String
  type             DiagramType
  projectId        String
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mermaidCode      String              @db.Text
  plantUmlCode     String?             @db.Text
  reactFlowNodes   Json?
  reactFlowEdges   Json?
  metadata         Json?
  viewMode         ViewMode            @default(ENGINEERING)
  isValid          Boolean             @default(false)
  validationScore  Int?
  promptHistory    PromptHistory[]
  validationReports ValidationReport[]
  exports          Export[]
  versions         DiagramVersion[]
  changeLog        DiagramChangeLog[]
  comments         Comment[]
  adrs             Adr[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([projectId])
}

model PromptHistory {
  id          String   @id @default(cuid())
  diagramId   String
  diagram     Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  prompt      String   @db.Text
  response    String   @db.Text
  actionType  String // generate | transform | analyze | explain
  createdAt   DateTime @default(now())

  @@index([diagramId])
}

model ValidationReport {
  id        String   @id @default(cuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  issues    Json // [{severity, message, rule, line?}]
  score     Int
  createdAt DateTime @default(now())

  @@index([diagramId])
}

model Export {
  id        String   @id @default(cuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  format    String // svg | png | pdf | plantuml | mermaid | json | typescript | java | python | csharp
  url       String
  createdAt DateTime @default(now())

  @@index([diagramId])
}

model DiagramVersion {
  id          String   @id @default(cuid())
  diagramId   String
  diagram     Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  version     Int
  label       String
  mermaidCode String   @db.Text
  summary     String   @db.Text
  changes     Json // string[] — human change notes for this snapshot
  createdAt   DateTime @default(now())

  // Unique per diagram: the VersionService computes the next number from
  // max+1 inside a transaction, and this constraint is the backstop that
  // turns racing saves into a retryable conflict instead of a duplicate.
  @@unique([diagramId, version])
}

model DiagramChangeLog {
  id        String   @id @default(cuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  summary   String   @db.Text
  createdAt DateTime @default(now())

  @@index([diagramId])
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Int // stored HTTP status of the original response
  body      Json // stored JSON body of the original response
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

/// Append-only audit trail for security compliance (Epic 6).
/// Every membership mutation and future org-scoped action lands here.
model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([createdAt])
}

/// Canvas comments pinned to diagrams (async collab — persisted per diagram).
model Comment {
  id        String   @id @default(cuid())
  diagramId String
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  x         Float
  y         Float
  createdAt DateTime @default(now())

  @@index([diagramId])
  @@index([authorId])
}

/// Architecture Decision Records persisted per diagram (async collab).
model Adr {
  id           String   @id @default(cuid())
  diagramId    String
  diagram      Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  status       String
  context      String   @db.Text
  decision     String   @db.Text
  consequences String   @db.Text
  linkedNodes  Json
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([diagramId, number])
  @@index([diagramId])
}

enum DiagramType {
  CLASS
  SEQUENCE
  USE_CASE
  STATE
  ACTIVITY
  COMPONENT
  DEPLOYMENT
  ER
  PACKAGE
}

enum ViewMode {
  EXECUTIVE
  ENGINEERING
}